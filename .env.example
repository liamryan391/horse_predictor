# Local development defaults
APP_ENV=development
DATABASE_URL=sqlite:///horse_racing.db
VITE_API_BASE_URL=http://127.0.0.1:8000

# Provider setup
# Keep sample until the local app works, then switch to generic, theracingapi, or ourhub.
HORSE_API_PROVIDER=sample

# Generic provider
# Built-in providers ignore this and use official hosts; set a full https:// URL only for `generic`.
HORSE_API_BASE_URL=
HORSE_API_KEY=
HORSE_API_TIMEOUT_SECONDS=30
HORSE_API_RETRY_ATTEMPTS=3
HORSE_API_RETRY_BACKOFF_SECONDS=1.5
HORSE_API_MIN_REQUEST_INTERVAL_SECONDS=0
HORSE_API_MAX_PAGES=5

# The Racing API
RACING_API_USERNAME=
RACING_API_PASSWORD=

# OurHub Racing uses HORSE_API_KEY and the default official adapter base URL.

# Local broker and optional local AI
BROKER_RAW_CACHE_DIR=broker_payloads
AI_PROVIDER=disabled
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_JSON_SCHEMA_REQUIRED=true
AI_API_KEY=

# API security settings for future staging/production work
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
API_AUTH_TOKEN=
JOURNAL_AUTH_TOKEN=
JOURNAL_ACCOUNT_KEY=journal-user
ACCOUNT_AUTH_ENABLED=true
ACCOUNT_AUTH_TOKEN=
API_RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BODY_BYTES=1048576
DATA_FRESHNESS_MAX_AGE_HOURS=24
LOG_FORMAT=plain
MODEL_ARTIFACT_DIR=model_artifacts
REQUIRE_APPROVED_MODEL_ARTIFACT=false
MONITORING_DRIFT_WARNING_THRESHOLD=0.35
MONITORING_DRIFT_CRITICAL_THRESHOLD=0.75
MONITORING_SLOW_REQUEST_MS=1000
MONITORING_MAX_ERROR_RATE=0.05
OTEL_ENABLED=false
OTEL_SERVICE_NAME=horse-predictor-api

# Product governance links
RESPONSIBLE_GAMBLING_URL=
PRIVACY_POLICY_URL=
TERMS_OF_USE_URL=
DATA_LICENSE_REFERENCE=
