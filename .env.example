# Local development defaults
APP_ENV=development
DATABASE_URL=sqlite:///horse_racing.db
VITE_API_BASE_URL=http://127.0.0.1:8000

# Generic provider
HORSE_API_PROVIDER=sample
HORSE_API_BASE_URL=
HORSE_API_KEY=
HORSE_API_TIMEOUT_SECONDS=30
HORSE_API_RETRY_ATTEMPTS=3
HORSE_API_RETRY_BACKOFF_SECONDS=1.5
HORSE_API_MIN_REQUEST_INTERVAL_SECONDS=0
HORSE_API_MAX_PAGES=5

# The Racing API
RACING_API_USERNAME=
RACING_API_PASSWORD=

# API security settings for future staging/production work
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
API_AUTH_TOKEN=
API_RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BODY_BYTES=1048576
DATA_FRESHNESS_MAX_AGE_HOURS=24
LOG_FORMAT=plain

# Product governance links
RESPONSIBLE_GAMBLING_URL=
PRIVACY_POLICY_URL=
TERMS_OF_USE_URL=
DATA_LICENSE_REFERENCE=
