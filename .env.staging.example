# Copy these values into the staging host secret store. Do not commit real staging secrets.
APP_ENV=staging
DATABASE_URL=mysql+pymysql://horse_user:replace_me@mysql-staging.example.com:3306/horse_predictor
BACKEND_CORS_ORIGINS=https://horse-predictor-staging.example.com
ALLOWED_HOSTS=horse-predictor-api-staging.example.com
API_AUTH_TOKEN=replace-with-a-long-random-token
API_RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BODY_BYTES=1048576
DATA_FRESHNESS_MAX_AGE_HOURS=24
LOG_FORMAT=json
MODEL_ARTIFACT_DIR=/app/model_artifacts
REQUIRE_APPROVED_MODEL_ARTIFACT=true

# Product governance links.
RESPONSIBLE_GAMBLING_URL=
PRIVACY_POLICY_URL=
TERMS_OF_USE_URL=
DATA_LICENSE_REFERENCE=

# Frontend build-time value.
VITE_API_BASE_URL=https://horse-predictor-api-staging.example.com

# Provider settings.
HORSE_API_PROVIDER=sample
HORSE_API_BASE_URL=
HORSE_API_KEY=
HORSE_API_TIMEOUT_SECONDS=30
HORSE_API_RETRY_ATTEMPTS=3
HORSE_API_RETRY_BACKOFF_SECONDS=1.5
HORSE_API_MIN_REQUEST_INTERVAL_SECONDS=0
HORSE_API_MAX_PAGES=5
RACING_API_USERNAME=
RACING_API_PASSWORD=

# Release helper.
SEED_SAMPLE_DATA=false
