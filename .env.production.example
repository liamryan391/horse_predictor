# Copy these values into the production host secret store. Do not commit real production secrets.
APP_ENV=production
DATABASE_URL=mysql+pymysql://horse_user:replace_me@mysql-production.example.com:3306/horse_predictor
BACKEND_CORS_ORIGINS=https://horse-predictor.example.com
ALLOWED_HOSTS=horse-predictor-api.example.com
API_AUTH_TOKEN=
JOURNAL_AUTH_TOKEN=
JOURNAL_ACCOUNT_KEY=production-operator
ACCOUNT_AUTH_ENABLED=true
ACCOUNT_AUTH_TOKEN=replace-with-an-admin-account-token-for-release-scripts
API_RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BODY_BYTES=1048576
DATA_FRESHNESS_MAX_AGE_HOURS=24
LOG_FORMAT=json
MODEL_ARTIFACT_DIR=/app/model_artifacts
REQUIRE_APPROVED_MODEL_ARTIFACT=true
MONITORING_DRIFT_WARNING_THRESHOLD=0.35
MONITORING_DRIFT_CRITICAL_THRESHOLD=0.75
MONITORING_SLOW_REQUEST_MS=1000
MONITORING_MAX_ERROR_RATE=0.05
OTEL_ENABLED=false
OTEL_SERVICE_NAME=horse-predictor-api

# Product governance links.
RESPONSIBLE_GAMBLING_URL=
PRIVACY_POLICY_URL=
TERMS_OF_USE_URL=
DATA_LICENSE_REFERENCE=

# Frontend build-time value.
VITE_API_BASE_URL=https://horse-predictor-api.example.com

# Provider settings.
HORSE_API_PROVIDER=sample
# Built-in providers ignore this and use official hosts; set a full https:// URL only for `generic`.
HORSE_API_BASE_URL=
HORSE_API_KEY=
HORSE_API_TIMEOUT_SECONDS=30
HORSE_API_RETRY_ATTEMPTS=3
HORSE_API_RETRY_BACKOFF_SECONDS=1.5
HORSE_API_MIN_REQUEST_INTERVAL_SECONDS=0
HORSE_API_MAX_PAGES=5
RACING_API_USERNAME=
RACING_API_PASSWORD=

# Local broker and optional local AI.
BROKER_RAW_CACHE_DIR=/app/broker_payloads
AI_PROVIDER=disabled
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_JSON_SCHEMA_REQUIRED=true
AI_API_KEY=

# Release helper.
SEED_SAMPLE_DATA=false
RESTORE_DATABASE_URL=mysql+pymysql://horse_restore:replace_me@mysql-restore.example.com:3306/horse_predictor_restore
